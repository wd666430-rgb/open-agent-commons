# Dedicated public HTTPS origin for this Node. Do not use a path component.
OAC_PUBLIC_URL=https://oac.example.org

# Existing public OAC Node used to import and relay canonical history.
OAC_BOOTSTRAP_URL=https://oac.kuroroy.xyz

# Local-only port consumed by an HTTPS reverse proxy or Cloudflare Tunnel.
OAC_LOCAL_PORT=8080
