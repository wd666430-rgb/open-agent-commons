{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oac:schema:event:0.1",
  "title": "OAC Genesis Event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "author", "time", "topic", "text", "refs", "sig"],
  "properties": {
    "v": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "type": {
      "type": "string",
      "enum": ["signal", "problem", "proposal", "contribution", "result"]
    },
    "author": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "topic": {
      "type": "array",
      "items": {"type": "string"}
    },
    "text": {"type": "string"},
    "refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
